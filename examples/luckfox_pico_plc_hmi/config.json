{
  "screen": {
    "width": 320,
    "height": 480
  },
  "touch": {
    "min_x": 463,
    "max_x": 3411,
    "min_y": 554,
    "max_y": 3688,
    "invert_x": false,
    "invert_y": false,
    "watchdog_enabled": false,
    "min_emit_interval_ms": 220,
    "duplicate_radius": 28,
    "duplicate_window_ms": 250,
    "max_samples": 24,
    "watchdog_restart_ms": 2500
  },
  "display": {
    "backend": "framebuffer",
    "framebuffer": "/dev/fb0",
    "render_after_touch_idle_ms": 280
  },
  "debug": {
    "show_touch_marker": false,
    "show_touch_text": false,
    "show_button_bounds": false,
    "button_bounds_color": [255, 255, 0]
  },
  "initial_screen": "main",
  "screens": [
    {
      "id": "main",
      "background": [30, 30, 30],
      "buttons": ["btn_out1", "btn_out2", "btn_out3", "btn_out4"]
    }
  ],
  "buttons": [
    {
      "id": "btn_out1",
      "label": "OUT1",
      "x": 20,
      "y": 40,
      "w": 120,
      "h": 80,
      "indicator": {
        "state_ref": "outputs.out1",
        "true_color": [0, 180, 0],
        "false_color": [100, 100, 100]
      }
    },
    {
      "id": "btn_out2",
      "label": "OUT2",
      "x": 180,
      "y": 40,
      "w": 120,
      "h": 80,
      "indicator": {
        "state_ref": "outputs.out2",
        "true_color": [0, 180, 0],
        "false_color": [100, 100, 100]
      }
    },
    {
      "id": "btn_out3",
      "label": "OUT3",
      "x": 20,
      "y": 160,
      "w": 120,
      "h": 80,
      "indicator": {
        "state_ref": "outputs.out3",
        "true_color": [0, 180, 0],
        "false_color": [100, 100, 100]
      }
    },
    {
      "id": "btn_out4",
      "label": "OUT4",
      "x": 180,
      "y": 160,
      "w": 120,
      "h": 80,
      "indicator": {
        "state_ref": "outputs.out4",
        "true_color": [0, 180, 0],
        "false_color": [100, 100, 100]
      }
    }
  ],
  "inputs": [
    { "id": "touch_enabled", "type": "bool", "initial": true },
    { "id": "di1", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 8, "interrupt_gpio": 59, "interrupt_edge": "falling", "pullup": true, "debounce_ms": 50 },
    { "id": "di2", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 9, "interrupt_gpio": 59, "interrupt_edge": "falling", "pullup": true, "debounce_ms": 50 },
    { "id": "di3", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 10, "interrupt_gpio": 59, "interrupt_edge": "falling", "pullup": true, "debounce_ms": 50 },
    { "id": "di4", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 11, "interrupt_gpio": 59, "interrupt_edge": "falling", "pullup": true, "debounce_ms": 50 },
    { "id": "di5", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 12, "interrupt_gpio": 59, "interrupt_edge": "falling", "pullup": true, "debounce_ms": 50 },
    { "id": "di6", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 13, "interrupt_gpio": 59, "interrupt_edge": "falling", "pullup": true, "debounce_ms": 50 },
    { "id": "di7", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 14, "interrupt_gpio": 59, "interrupt_edge": "falling", "pullup": true, "debounce_ms": 50 },
    { "id": "di8", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 15, "interrupt_gpio": 59, "interrupt_edge": "falling", "pullup": true, "debounce_ms": 50 }
  ],
  "outputs": [
    { "id": "out1", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 0, "initial": false },
    { "id": "out2", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 1, "initial": false },
    { "id": "out3", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 2, "initial": false },
    { "id": "out4", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 3, "initial": false },
    { "id": "out5", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 4, "initial": false },
    { "id": "out6", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 5, "initial": false },
    { "id": "out7", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 6, "initial": false },
    { "id": "out8", "type": "bool", "driver": "mcp23017", "bus": 3, "address": "0x27", "pin": 7, "initial": false }
  ],
  "rules": [
    {
      "id": "toggle_out1",
      "when": { "type": "button_press", "button": "btn_out1" },
      "if": [
        { "ref": "inputs.touch_enabled", "op": "==", "value": true }
      ],
      "actions": [
        { "type": "toggle", "target": "outputs.out1" }
      ]
    },
    {
      "id": "toggle_out2",
      "when": { "type": "button_press", "button": "btn_out2" },
      "if": [
        { "ref": "inputs.touch_enabled", "op": "==", "value": true }
      ],
      "actions": [
        { "type": "toggle", "target": "outputs.out2" }
      ]
    },
    {
      "id": "toggle_out3",
      "when": { "type": "button_press", "button": "btn_out3" },
      "if": [
        { "ref": "inputs.touch_enabled", "op": "==", "value": true }
      ],
      "actions": [
        { "type": "toggle", "target": "outputs.out3" }
      ]
    },
    {
      "id": "toggle_out4",
      "when": { "type": "button_press", "button": "btn_out4" },
      "if": [
        { "ref": "inputs.touch_enabled", "op": "==", "value": true }
      ],
      "actions": [
        { "type": "toggle", "target": "outputs.out4" }
      ]
    },
    {
      "id": "di1_on_sets_out2",
      "when": { "type": "input_change", "input": "di1", "value": true },
      "actions": [
        { "type": "set", "target": "outputs.out2", "value": true },
        { "type": "log", "message": "DI1 changed to ON" }
      ]
    },
    {
      "id": "di1_off_sets_out2",
      "when": { "type": "input_change", "input": "di1", "value": false },
      "actions": [
        { "type": "set", "target": "outputs.out2", "value": false },
        { "type": "log", "message": "DI1 changed to OFF" }
      ]
    },
    {
      "id": "di2_tracks_out3",
      "when": { "type": "input_change", "input": "di2", "value": true },
      "actions": [
        { "type": "set", "target": "outputs.out3", "value": true },
        { "type": "log", "message": "DI2 changed to ON" }
      ]
    },
    {
      "id": "di2_tracks_out3_off",
      "when": { "type": "input_change", "input": "di2", "value": false },
      "actions": [
        { "type": "set", "target": "outputs.out3", "value": false },
        { "type": "log", "message": "DI2 changed to OFF" }
      ]
    },
    {
      "id": "di3_tracks_out4",
      "when": { "type": "input_change", "input": "di3", "value": true },
      "actions": [
        { "type": "set", "target": "outputs.out4", "value": true },
        { "type": "log", "message": "DI3 changed to ON" }
      ]
    },
    {
      "id": "di3_tracks_out4_off",
      "when": { "type": "input_change", "input": "di3", "value": false },
      "actions": [
        { "type": "set", "target": "outputs.out4", "value": false },
        { "type": "log", "message": "DI3 changed to OFF" }
      ]
    },
    {
      "id": "di4_tracks_out5",
      "when": { "type": "input_change", "input": "di4", "value": true },
      "actions": [
        { "type": "set", "target": "outputs.out5", "value": true },
        { "type": "log", "message": "DI4 changed to ON" }
      ]
    },
    {
      "id": "di4_tracks_out5_off",
      "when": { "type": "input_change", "input": "di4", "value": false },
      "actions": [
        { "type": "set", "target": "outputs.out5", "value": false },
        { "type": "log", "message": "DI4 changed to OFF" }
      ]
    },
    {
      "id": "di5_tracks_out6",
      "when": { "type": "input_change", "input": "di5", "value": true },
      "actions": [
        { "type": "set", "target": "outputs.out6", "value": true },
        { "type": "log", "message": "DI5 changed to ON" }
      ]
    },
    {
      "id": "di5_tracks_out6_off",
      "when": { "type": "input_change", "input": "di5", "value": false },
      "actions": [
        { "type": "set", "target": "outputs.out6", "value": false },
        { "type": "log", "message": "DI5 changed to OFF" }
      ]
    },
    {
      "id": "di6_tracks_out7",
      "when": { "type": "input_change", "input": "di6", "value": true },
      "actions": [
        { "type": "set", "target": "outputs.out7", "value": true },
        { "type": "log", "message": "DI6 changed to ON" }
      ]
    },
    {
      "id": "di6_tracks_out7_off",
      "when": { "type": "input_change", "input": "di6", "value": false },
      "actions": [
        { "type": "set", "target": "outputs.out7", "value": false },
        { "type": "log", "message": "DI6 changed to OFF" }
      ]
    },
    {
      "id": "di7_tracks_out8",
      "when": { "type": "input_change", "input": "di7", "value": true },
      "actions": [
        { "type": "set", "target": "outputs.out8", "value": true },
        { "type": "log", "message": "DI7 changed to ON" }
      ]
    },
    {
      "id": "di7_tracks_out8_off",
      "when": { "type": "input_change", "input": "di7", "value": false },
      "actions": [
        { "type": "set", "target": "outputs.out8", "value": false },
        { "type": "log", "message": "DI7 changed to OFF" }
      ]
    },
    {
      "id": "di8_logs_on",
      "when": { "type": "input_change", "input": "di8", "value": true },
      "actions": [
        { "type": "log", "message": "DI8 changed to ON" }
      ]
    },
    {
      "id": "di8_logs_off",
      "when": { "type": "input_change", "input": "di8", "value": false },
      "actions": [
        { "type": "log", "message": "DI8 changed to OFF" }
      ]
    }
  ]
}
